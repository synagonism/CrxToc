{
  "manifest_version": 3,
  "name": "table-of-contents-Crx",
  "version": "2026.09.01.17",

  "description": "Creates an expandable Table-of-Contents on ANY web-page with headings",
  "short_name": "crxToc",

  "icons": { "16": "toc-img-16.png",
             "48": "toc-img-48.png",
            "128": "toc-img-128.png" },

  "action": {
    "default_icon": "toc-img-16.png",
    "default_title": "table-of-contents-Crx"
  },

  "content_scripts": [{
    "css": [ "toc.css" ],
    "js": [ "jquery-2.0.3.min.js", "toc.js" ],
    "matches": [ "<all_urls>" ],
    "run_at": "document_end"
  }],

  "background": {
    "service_worker": "toc-event-page.js"
  },

  "permissions": [ "tabs", "storage" ],

  "host_permissions": [ "http://*/*", "https://*/*" ],

  "web_accessible_resources": [
    {
      "resources": [ "jquery-2.0.3.min.map" ],
      "matches": [ "<all_urls>" ]
    }
  ]

}
